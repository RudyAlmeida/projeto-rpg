speaker = "Mestre Gerd"
portrait = ExtResource("6_t8eku")
text = "A válvula deve estar lá no fundo, perto do poço das engrenagens. Fica de olho nos bichos."

[sub_resource type="Resource" id="Resource_1l3wr"]
script = ExtResource("4_4dsu0")
speaker = "Dica"
text = "Os inimigos aparecem no mapa. Encoste neles pelas costas para agir primeiro; se eles te pegarem pelas costas, é emboscada."

