[sub_resource type="Resource" id="Resource_nv737"]
script = ExtResource("4_2324d")
speaker = "Mestre Gerd"
portrait = ExtResource("6_tkrh8")
text = "Olha ali na estrada. Slimes de óleo. Vazou alguma coisa do ferro-velho de novo."

[sub_resource type="Resource" id="Resource_obecb"]
