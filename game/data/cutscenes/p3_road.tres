speaker = "Mestre Gerd"
portrait = ExtResource("6_tkrh8")
text = "Bom reflexo. Quando o anel fechar, é aí que a máquina quer que você bata. Escuta ela."

[sub_resource type="Resource" id="Resource_60tre"]
