[sub_resource type="Resource" id="Resource_w7tv8"]
script = ExtResource("4_2324d")
speaker = "Dica"
text = "No topo da tela fica a fila de turnos: quem é mais rápido age mais vezes."

[sub_resource type="Resource" id="Resource_lnap5"]
script = ExtResource("4_2324d")
speaker = "Dica"
text = "Ao atacar, aperte Z / A quando o anel dourado fechar sobre o alvo: golpe Perfeito!"

[sub_resource type="Resource" id="Resource_x20kj"]
script = ExtResource("4_2324d")
speaker = "Dica"
text = "Na vez do inimigo, aperte no momento do impacto para se defender e receber menos dano."

[sub_resource type="Resource" id="Resource_tofd2"]
script = ExtResource("2_roquf")
