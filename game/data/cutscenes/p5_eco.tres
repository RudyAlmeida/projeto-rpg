[sub_resource type="Resource" id="Resource_8xlrt"]
script = ExtResource("4_qu4mf")
speaker = "Kael"
portrait = ExtResource("6_g8ho6")
text = "(Ela tá... quieta agora. Obrigada, ela disse. Eu acho.)"

[sub_resource type="Resource" id="Resource_rj0xh"]
script = ExtResource("4_qu4mf")
speaker = "Eco"
portrait = ExtResource("8_ns1e7")
text = "Observação: Kael conversa com máquinas desligadas. Registrando como comportamento normal."

[sub_resource type="Resource" id="Resource_nvmix"]
script = ExtResource("4_qu4mf")
speaker = "Mestre Gerd"
portrait = ExtResource("7_wi1ph")
text = "Pega a válvula e vamos pra casa. Esse lugar me dá arrepio."

[sub_resource type="Resource" id="Resource_s0xlr"]
script = ExtResource("4_qu4mf")
text = "Kael encontrou: Válvula de Bronze e Lâmina-engrenagem!"

