[sub_resource type="Resource" id="Resource_1yfwm"]
script = ExtResource("2_5cmh0")
type = 23

[sub_resource type="Resource" id="Resource_g8ho6"]
script = ExtResource("2_5cmh0")
type = 3
seconds = 0.8

[sub_resource type="Resource" id="Resource_wi1ph"]
script = ExtResource("4_stnnv")
speaker = "Kael"
portrait = ExtResource("6_l5jcm")
text = "Mestre... o senhor tá ouvindo isso?"

[sub_resource type="Resource" id="Resource_ns1e7"]
script = ExtResource("4_stnnv")
speaker = "Mestre Gerd"
portrait = ExtResource("7_8aafx")
text = "(pausa) ...Ouvindo o quê, garoto?"

[sub_resource type="Resource" id="Resource_ocvjc"]
script = ExtResource("2_5cmh0")
lines = Array[ExtResource("4_stnnv")]([SubResource("Resource_wi1ph"), SubResource("Resource_ns1e7")])

[sub_resource type="Resource" id="Resource_1x1re"]
script = ExtResource("2_5cmh0")
type = 1
actor = NodePath("Player")
position = Vector2(200, 120)
speed = 30.0

[sub_resource type="Resource" id="Resource_qljoo"]
script = ExtResource("2_5cmh0")
type = 15
seconds = 0.8
color = Color(0.31, 0.88, 0.82, 1)

[sub_resource type="Resource" id="Resource_0465w"]
script = ExtResource("4_stnnv")
speaker = "???"
text = "...Kael."

[sub_resource type="Resource" id="Resource_4vgr8"]
script = ExtResource("4_stnnv")
speaker = "Kael"
portrait = ExtResource("6_l5jcm")
text = "Ele... ele sabe meu nome!"

[sub_resource type="Resource" id="Resource_yg4so"]
script = ExtResource("4_stnnv")
speaker = "Mestre Gerd"
portrait = ExtResource("7_8aafx")
text = "(baixinho, para si) ...Então ainda funciona."

[sub_resource type="Resource" id="Resource_8s8yr"]
script = ExtResource("4_stnnv")
speaker = "Kael"
portrait = ExtResource("6_l5jcm")
text = "O senhor disse alguma coisa?"

[sub_resource type="Resource" id="Resource_2a8an"]
script = ExtResource("4_stnnv")
speaker = "Mestre Gerd"
portrait = ExtResource("7_8aafx")
text = "Disse que isso aí deve valer uma fortuna. Vamos embora."

[sub_resource type="Resource" id="Resource_xqic7"]
script = ExtResource("4_stnnv")
speaker = "???"
text = "Designação: E-C-O. Diretiva: ...dado corrompido. Kael: presente. Diretiva parcialmente cumprida."

[sub_resource type="Resource" id="Resource_dsn8d"]
script = ExtResource("4_stnnv")
speaker = "Kael"
portrait = ExtResource("6_l5jcm")
text = "Eco. Tá bom, Eco. Você... vem com a gente?"

[sub_resource type="Resource" id="Resource_y7c28"]
script = ExtResource("4_stnnv")
speaker = "Eco"
text = "Afirmativo. Pergunta: o que é \"a gente\"?"

[sub_resource type="Resource" id="Resource_2orow"]
script = ExtResource("4_stnnv")
text = "Eco entrou no grupo!"

[sub_resource type="Resource" id="Resource_dqy21"]
script = ExtResource("2_5cmh0")
lines = Array[ExtResource("4_stnnv")]([SubResource("Resource_0465w"), SubResource("Resource_4vgr8"), SubResource("Resource_yg4so"), SubResource("Resource_8s8yr"), SubResource("Resource_2a8an"), SubResource("Resource_xqic7"), SubResource("Resource_dsn8d"), SubResource("Resource_y7c28"), SubResource("Resource_2orow")])

[sub_resource type="Resource" id="Resource_wyflc"]
script = ExtResource("2_5cmh0")
type = 10
id = &"eco"
amount = 0

[sub_resource type="Resource" id="Resource_7u7i6"]
script = ExtResource("2_5cmh0")
type = 6
id = &"eco_awake"

[sub_resource type="Resource" id="Resource_pxb00"]
script = ExtResource("2_5cmh0")
type = 14
seconds = 1.2
strength = 5.0

[sub_resource type="Resource" id="Resource_k54ic"]
script = ExtResource("4_stnnv")
text = "O pulso de Éter do despertar reativa algo enorme na sucata acima da câmara..."

[sub_resource type="Resource" id="Resource_tec4p"]
script = ExtResource("4_stnnv")
speaker = "Eco"
text = "Alerta. Máquina hostil. Nível de irritação: elevado."

[sub_resource type="Resource" id="Resource_stw54"]
script = ExtResource("4_stnnv")
speaker = "Kael"
portrait = ExtResource("6_l5jcm")
text = "Ela tá com dor! Os braços tão travados... se eu soltar as garras, ela para!"

[sub_resource type="Resource" id="Resource_bph01"]
script = ExtResource("4_stnnv")
speaker = "Dica"
text = "As garras protegem o núcleo: ele só recebe dano cheio depois que uma garra cai."

[sub_resource type="Resource" id="Resource_7vjri"]
script = ExtResource("4_stnnv")
speaker = "Dica"
text = "Ressonância (Kael) desmonta inimigos mecânicos. E se a fornalha se abrir, o Proteger de Eco impede que alguém seja puxado."

[sub_resource type="Resource" id="Resource_1tqh5"]
script = ExtResource("2_5cmh0")
lines = Array[ExtResource("4_stnnv")]([SubResource("Resource_k54ic"), SubResource("Resource_tec4p"), SubResource("Resource_stw54"), SubResource("Resource_bph01"), SubResource("Resource_7vjri")])

[sub_resource type="Resource" id="Resource_jouhi"]
script = ExtResource("2_5cmh0")
type = 12
music = ExtResource("8_qu4mf")

[sub_resource type="Resource" id="Resource_4dsog"]
script = ExtResource("4_stnnv")
speaker = "Kael"
portrait = ExtResource("6_l5jcm")
text = "(Ela tá... quieta agora. Obrigada, ela disse. Eu acho.)"

[sub_resource type="Resource" id="Resource_bxb50"]
script = ExtResource("4_stnnv")
speaker = "Eco"
text = "Observação: Kael conversa com máquinas desligadas. Registrando como comportamento normal."

[sub_resource type="Resource" id="Resource_g431e"]
script = ExtResource("4_stnnv")
speaker = "Mestre Gerd"
portrait = ExtResource("7_8aafx")
text = "Pega a válvula e vamos pra casa. Esse lugar me dá arrepio."

[sub_resource type="Resource" id="Resource_0mdku"]
script = ExtResource("4_stnnv")
text = "Kael encontrou: Válvula de Bronze e Lâmina-engrenagem!"

[sub_resource type="Resource" id="Resource_yxbx5"]
script = ExtResource("2_5cmh0")
lines = Array[ExtResource("4_stnnv")]([SubResource("Resource_4dsog"), SubResource("Resource_bxb50"), SubResource("Resource_g431e"), SubResource("Resource_0mdku")])

