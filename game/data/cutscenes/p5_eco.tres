[sub_resource type="Resource" id="Resource_8s8yr"]
script = ExtResource("4_qu4mf")
speaker = "Kael"
portrait = ExtResource("6_g8ho6")
text = "Mestre... o senhor tá ouvindo isso?"

[sub_resource type="Resource" id="Resource_2a8an"]
script = ExtResource("4_qu4mf")
speaker = "Mestre Gerd"
portrait = ExtResource("7_wi1ph")
text = "(pausa) ...Ouvindo o quê, garoto?"

