[sub_resource type="Resource" id="Resource_m4v8v"]
script = ExtResource("4_tgb4j")
speaker = "Kael"
portrait = ExtResource("7_4hp2k")
text = "O senhor vem com a gente!"

[sub_resource type="Resource" id="Resource_3wvav"]
script = ExtResource("4_tgb4j")
speaker = "Mestre Gerd"
portrait = ExtResource("8_p7flu")
text = "Esses joelhos não correm mais, garoto. Mas esta oficina ainda sabe fazer barulho."

[sub_resource type="Resource" id="Resource_sav4d"]
script = ExtResource("4_tgb4j")
speaker = "Mestre Gerd"
portrait = ExtResource("8_p7flu")
text = "Vai pro norte. Pra floresta. E Kael..."

[sub_resource type="Resource" id="Resource_u1rnr"]
script = ExtResource("4_tgb4j")
speaker = "Mestre Gerd"
portrait = ExtResource("8_p7flu")
text = "...escuta ele. Ele sabe mais do que parece. Eu devia ter te contado tudo antes."

[sub_resource type="Resource" id="Resource_whmvv"]
script = ExtResource("4_tgb4j")
speaker = "Eco"
text = "Gerd Brunor. Pergunta: você vem \"amanhã\"?"

[sub_resource type="Resource" id="Resource_wnpvg"]
script = ExtResource("4_tgb4j")
speaker = "Mestre Gerd"
portrait = ExtResource("8_p7flu")
text = "(sorri) ...Cuida dele, lata velha."

[sub_resource type="Resource" id="Resource_0xr8u"]
